{
    "folders": [
        { "path": "." }
    ],
    "settings": {
        "files.exclude": {
            "bin": true,
            "bin-int": true,
            ".vs": true
        },
        "search.exclude": {
            "Hoowan/vendor": true
        },
        "files.associations": {
            "*.glsl": "glsl",
            "*.inl": "cpp"
        },
        "C_Cpp.default.cppStandard": "c++17",
        "debug.onTaskErrors": "abort"
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cpptools-extension-pack"
        ]
    }
}
